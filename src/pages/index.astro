---
import Layout from "~/layouts/Layout.astro";

import Intro from "~/components/home/Intro.astro";
import Skills from "~/components/home/Skills.astro";
import Employment from "~/components/home/Employment.astro";
import Projects from "~/components/home/Projects.astro";
import Now from "~/components/home/Now.astro";

import { getHomeContent } from "~/lib/home";

const { description } = await getHomeContent();
---

<Layout
  noTopPadding={true}
  h1Title={true}
  description={description}
>
  <Intro />
  <Now />
  <Skills />
  <Employment />
  <Projects />
</Layout>

<style lang="scss"></style>
