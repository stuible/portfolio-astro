---
import type { CollectionEntry } from "astro:content";
import BaseCard from "~/components/global/BaseCard.astro";
import IconPill from "~/components/global/IconPill.vue";
import { getTechBySlugs } from "~/lib/tech";

export interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const techWithIcons = await getTechBySlugs(project.data.tags);
---

<BaseCard class="project-card" href={`/project/${project.id}`}>
  <div class="title">{project.data.title}</div>
  <div class="subtitle">{project.data.subtitle}</div>
  <ul class="tags">
    {techWithIcons.map((item) => <li class="tag">
      <IconPill label={item.name} icon={item.icon} colour={item.colour} small />
    </li>)}
  </ul>
</BaseCard>

<style lang="scss">
  :global(.project-card) {
    display: flex;
    height: 100%;
    flex-wrap: wrap;

    > * {
      flex: 0 0 100%;
    }

    .title {
      margin-bottom: $spacing-xs;
      font-size: 0.75rem;
      font-weight: 500;
    }

    .subtitle {
      margin-bottom: $spacing-xs;
      color: $colour-muted;
      font-size: 0.5em;
      line-height: 1.25em;
    }

    .tags {
      display: flex;
      align-self: flex-end;
      flex-wrap: wrap;
      gap: 0.25rem;
    }
  }
</style>
