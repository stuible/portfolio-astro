---
import { type CollectionEntry, getEntry } from "astro:content";
import BaseCard from "~/components/global/BaseCard.astro";
import IconPill from "~/components/global/IconPill.vue";

export interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const {
  data: { tech },
} = await getEntry("categories", "tech");

const icons = Object.values(
  import.meta.glob("~/assets/icons/*.svg", { eager: true })
).map((x: any) => x.default.src);

const techWithIcons = await Promise.all(
  await project.data.tags.map(async (techSlug) => {
    const techItem = tech.find((x) => x.slug === techSlug);

    return {
      ...techItem,
      icon: icons.find((x) => x.includes(techItem.icon)),
    };
  })
);
---

<BaseCard class="project-card" href={`/project/${project.slug}`}>
  <div class="title">{project.data.title}</div>
  <div class="subtitle">{project.data.subtitle}</div>
  <ul class="tags">
    {
      techWithIcons.map((item, index) => (
        <li class="tag">
          <IconPill
            label={item.name}
            icon={item.icon}
            colour={item.colour}
            small
          />
        </li>
      ))
    }
  </ul>
</BaseCard>

<style lang="scss">
  :global(.project-card) {
    display: flex;
    height: 100%;
    flex-wrap: wrap;
    padding: 1.25rem 1.25rem 1rem;
    border-radius: 1rem;

    > * {
      flex: 0 0 100%;
    }

    .title {
      margin-bottom: $spacing-xs;
      font-size: 0.75rem;
      font-weight: 500;
    }

    .subtitle {
      margin-bottom: $spacing-xs;
      color: gray;
      font-size: 0.5em;
      line-height: 1.25em;
    }

    .tags {
      display: flex;
      align-self: flex-end;
      flex-wrap: wrap;
      gap: 0.25rem;
    }
  }
</style>
