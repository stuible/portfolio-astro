---
export interface Props {
  value: string;
}

const { value } = Astro.props;
---

<div class="stat">
  <span class="value">{value}</span>
  <span class="label"><slot /></span>
</div>

<style lang="scss">
  .stat {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 18px 20px;
    border: 1px solid #e8e8e8;
    border-radius: 16px;

    @include breakpoint(md) {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      padding: 24px;
    }
  }

  .value {
    flex-shrink: 0;
    min-width: 4.5em;
    font-size: 30px;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.01em;

    @include breakpoint(md) {
      min-width: 0;
      font-size: 2em;
    }
  }

  .label {
    font-size: max(0.7em, 14px);
    font-weight: 300;
    line-height: 1.45;
    color: #4a4a4a;
  }
</style>
