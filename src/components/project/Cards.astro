---
export interface Props {
  cols?: number;
}

const { cols } = Astro.props;
---

<div
  class:list={["cards", { fixed: cols }]}
  style={cols ? `--cols: ${cols}` : undefined}
>
  <slot />
</div>

<style lang="scss">
  .cards {
    display: grid;
    gap: 12px;
    margin-bottom: $spacing-md;

    // Side by side only once the content column reaches its full width
    @include breakpoint(lg) {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);

      &.fixed {
        grid-auto-flow: row;
        grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
      }
    }
  }
</style>
