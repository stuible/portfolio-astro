---
import { Icon } from "astro-icon/components";

export interface Props {
  title?: string;
  // A Lucide icon name, e.g. "search" (https://lucide.dev/icons)
  icon?: string;
  // A headline figure, e.g. "70%", shown large above the title and body. The
  // icon, if any, sits after it instead of beside the title.
  value?: string;
}

const { title, icon, value } = Astro.props;
---

<div class="card">
  {
    value && (
      <span class="stat">
        <span class="value">{value}</span>
        {icon && <Icon name={`lucide:${icon}`} class="icon" aria-hidden="true" />}
      </span>
    )
  }
  {
    (title || (icon && !value)) && (
      <span class="title">
        {icon && !value && <Icon name={`lucide:${icon}`} class="icon" aria-hidden="true" />}
        {title && <span>{title}</span>}
      </span>
    )
  }
  <div class="card-body"><slot /></div>
</div>

<style lang="scss">
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 22px;
    border: 1px solid #e8e8e8;
    border-radius: 14px;
    font-size: max(0.8em, 15px);
  }

  .title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    line-height: 1.3;
    color: #2e2e2e;
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .value {
    font-size: 2em;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.01em;
    color: #2e2e2e;
  }

  // Graphik's metrics sit the glyphs high in the line box, so nudge them down
  // to optically center against the icon
  .title > span {
    position: relative;
    top: 0.05em;
  }

  .icon {
    display: block;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    color: #8f8f8f;
  }

  .card-body {
    font-size: 0.95em;
    font-weight: 300;
    line-height: 1.55;
    color: #4a4a4a;

    :global(p) {
      line-height: inherit;
      margin-bottom: 0.5em;
      max-width: none;
    }

    :global(p:last-child) {
      margin-bottom: 0;
    }
  }
</style>
