---
import ProjectImage from "~/components/project/ProjectImage.astro";

export interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  widths?: number[];
  sizes?: string;
}

const { src, alt, caption, widths, sizes } = Astro.props;
---

<figure>
  <ProjectImage {src} {alt} {widths} {sizes} />
  <figcaption>{caption}</figcaption>
</figure>

<style lang="scss">
  figure {
    margin: 0 0 1.5rem;

    :global(img) {
      display: block;
      border: 1px solid #ebebeb;
      border-radius: 12px;
    }
  }

  figcaption {
    margin-top: 16px;
    color: #666;
    font-size: max(0.7em, 13px);
    font-style: normal;
    font-weight: inherit;
    line-height: 1.4;
    text-align: center;
  }
</style>
