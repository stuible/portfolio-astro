---
import { Picture } from "astro:assets";

export interface Props {
  src: ImageMetadata | Promise<{ default: ImageMetadata }>;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
}

// Defaults match the project content column: 708px from the lg breakpoint,
// 488px from md, and the viewport minus page gutters below that. The widths
// cover that column at 1x and 2x pixel density.
const {
  src,
  alt,
  widths = [800, 1200, 1512],
  sizes = "(min-width: 820px) 708px, (min-width: 600px) 488px, calc(100vw - 56px)",
  class: className,
} = Astro.props;
---

<Picture
  {src}
  {widths}
  {sizes}
  formats={["avif", "webp"]}
  {alt}
  class:list={["markdown-image", className]}
/>
