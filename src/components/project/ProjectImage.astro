---
import { Picture } from "astro:assets";

export interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  widths?: number[];
  sizes?: string;
}

// Defaults match the project content column: 708px from the lg breakpoint,
// 488px from md, and the viewport minus page gutters below that. The widths
// cover that column at 1x and 2x pixel density.
const {
  src,
  alt,
  caption,
  widths = [800, 1200, 1512],
  sizes = "(min-width: 820px) 708px, (min-width: 600px) 488px, calc(100vw - 56px)",
} = Astro.props;
---

<figure>
  <Picture
    {src}
    {widths}
    {sizes}
    formats={["avif", "webp"]}
    {alt}
    class="markdown-image"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style lang="scss">
  figure {
    margin: 0 0 1.5rem;

    :global(img) {
      display: block;
      border: 1px solid #ebebeb;
      border-radius: 12px;
    }
  }

  figcaption {
    margin-top: 16px;
    color: #666;
    font-size: max(0.7em, 13px);
    font-style: normal;
    font-weight: inherit;
    line-height: 1.4;
    text-align: center;
  }
</style>
