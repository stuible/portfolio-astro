---
export interface Props {
  name: string;
  icon?: string;
  colour?: string;
}

const { name, icon, colour = "#f5f5f5" } = Astro.props;
---

<span class="badge" style={`background: ${colour}`}>
  <span class="badge-icon">
    {icon && <img src={icon} width="26" height="26" alt="" />}
  </span>
  {name}
</span>
