---
import LinkButton from "../global/LinkButton.astro";

import github from "../../assets/icons/github.svg";
import linkedin from "../../assets/icons/linkedin.svg";
import mail from "../../assets/icons/mail.svg";

import { getHomeContent } from "~/lib/home";

const { bio } = await getHomeContent();
---

<section class="section has-icon" data-icon="logo">
  <p class="body bio">{bio}</p>

  <ul class="contact-links">
    <li>
      <LinkButton
        label="github"
        url="https://github.com/stuible"
        icon={github}
      />
    </li>
    <li>
      <LinkButton
        label="linkedin"
        url="https://www.linkedin.com/in/stuible/"
        icon={linkedin}
      />
    </li>
    <li>
      <LinkButton
        label="josh@stuible.com"
        url="mailto:josh@stuible.com"
        icon={mail}
      />
    </li>
  </ul>
</section>

<style lang="scss">
  .contact-links {
    display: flex;
    gap: $spacing-sm;
    flex-wrap: wrap;
    margin-bottom: $spacing-md;
  }
  .bio {
    margin-bottom: $spacing-md;
    max-width: 48ch;
  }
</style>
