---
import Tech from "./Tech.vue";
import { getHomeContent } from "~/lib/home";
import { getTechWithIcons } from "~/lib/tech";

const { skills } = await getHomeContent();

// Don't show some of the tech on landing page
const techWithIcons = (await getTechWithIcons()).filter(
  (item) => !skills.exclude.includes(item.slug)
);
---

<section class="section has-icon" data-icon="skills">
  <h2 class="section-title">My Focus</h2>
  <p class="body">{skills.body}</p>

  <h3 class="section-subtitle">Skills</h3>
  <Tech techWithIcons={techWithIcons} client:visible />
</section>

<style lang="scss">
  section {
    // display: grid;
    grid-template-columns: 2fr 3fr;
    > .body {
      margin-bottom: 2rem;
    }
  }
</style>
